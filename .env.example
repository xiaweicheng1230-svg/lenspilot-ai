# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/lenspilot.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000
CORS_ORIGINS=http://localhost:3000
# Optional Python regex for preview deployments, for example:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# AI provider
# With MOCK_AI=true, no API key is required.
MOCK_AI=true
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Frontend (used by the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1


